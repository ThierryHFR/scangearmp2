<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkDialog" id="dialog_error">
    <property name="title">ScanGear</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox6">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkLabel" id="label_error_msg">
            <property name="label">xxxxxxxxxxxxxxxxxxx</property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="0">button_error_cancel</action-widget>
      <action-widget response="0">button_error_ok</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area6">
        <property name="valign">center</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="button_error_cancel">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_05">Cancel</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_error_ok">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_04">OK</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_notify">
    <property name="title">ScanGear</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox4">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkLabel" id="label_notify_save">
          </object>
        </child>
      </object>
    </child>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area4">
        <property name="valign">center</property>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_progress">
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox5">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="vbox3">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="label_prog_msg">
                <property name="label">xxxxx</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_prog_percent">
                <property name="valign">center</property>
                <property name="vexpand">1</property>
                <property name="label">xxxxx</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="alignment1">
                <property name="vexpand">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkProgressBar" id="progressbar_prog">
                    <property name="width-request">270</property>
                    <property name="height-request">30</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_prog_pages">
                <property name="valign">center</property>
                <property name="vexpand">1</property>
                <property name="label">xxxxx</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="0">button_prog_cancel</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area5">
        <property name="valign">center</property>
        <property name="visible">True</property>
        <child>
          <placeholder/>
        </child>
        <child>
          <object class="GtkButton" id="button_prog_cancel">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_05">Cancel</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_save">
    <property name="title" translatable="1" comments="STR_CNMS_LS_008_01">Save Scan Image</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox2">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkFileChooserWidget" id="filechooserwidget_save">
            <property name="action">save</property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="0">button_save_cancel</action-widget>
      <action-widget response="0">button_save_save</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area2">
        <property name="valign">center</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="button_save_cancel">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_05">Cancel</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_save_save">
            <property name="label" translatable="1" comments="STR_CNMS_LS_008_02">Save</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_select">
    <property name="title" translatable="1" comments="STR_CNMS_LS_011_01">Select Scanner</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="hbox1">
            <child>
              <placeholder/>
            </child>
            <child>
              <object class="GtkBox" id="vbox2">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkComboBoxText" id="combobox_select_devlist">
                    <property name="vexpand">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label_select_nodev">
                    <property name="valign">center</property>
                    <property name="vexpand">1</property>
                    <property name="label" translatable="1" comments="STR_CNMS_LS_011_02">No scanners detected.</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_select_update">
                    <property name="valign">center</property>
                    <property name="vexpand">1</property>
                    <property name="label" translatable="1" comments="STR_CNMS_LS_011_03">Update Scanner List</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="0">button_select_cancel</action-widget>
      <action-widget response="0">button_select_ok</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="valign">center</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="button_select_cancel">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_05">Cancel</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_select_ok">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_04">OK</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_version">
    <property name="title">ScanGear</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox3">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="orientation">vertical</property>
            <child>
              <placeholder/>
            </child>
            <child>
              <object class="GtkLabel" id="label_version_app">
                <property name="vexpand">1</property>
                <property name="label">xxxxx</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_version_ver">
                <property name="vexpand">1</property>
                <property name="label">xxxxx</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_version_cpy">
                <property name="vexpand">1</property>
                <property name="label">xxxxx</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label1">
                <property name="vexpand">1</property>
                <property name="height-request">20</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="0">button_version_ok</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area3">
        <property name="valign">center</property>
        <property name="visible">True</property>
        <child>
          <placeholder/>
        </child>
        <child>
          <object class="GtkButton" id="button_version_ok">
            <property name="label" translatable="1" comments="STR_CNMS_LS_011_04">OK</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="window_main">
    <property name="title">ScanGear</property>
    <property name="default-width">900</property>
    <property name="default-height">590</property>
    <property name="resizable">1</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="button_clear_preview">
                <property name="label" translatable="1">Clear Preview</property>
                <property name="sensitive">0</property>
                <property name="tooltip-text" translatable="1">Clear the last scanned image.</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_version">
                <property name="label" translatable="1" comments="STR_CNMS_LS_001_09">About</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="hexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_devname">
                <property name="label">Canon XXXXXX series</property>
                <property name="ellipsize">end</property>
                <style><class name="heading"/></style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkFrame">
                <property name="label" translatable="1">Preview</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="child">
                  <object class="GtkOverlay">
                    <property name="halign">fill</property>
                    <property name="valign">fill</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="GtkPicture" id="preview_picture">
                        <property name="content-fit">contain</property>
                        <property name="can-shrink">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="visible">0</property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkLabel" id="preview_placeholder">
                        <property name="label" translatable="1">The last JPEG scan will appear here.</property>
                        <property name="wrap">1</property>
                        <property name="justify">center</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="width-chars">34</property>
                        <style><class name="dim-label"/></style>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkDrawingArea" id="preview_crop_area">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="can-target">1</property>
                        <property name="tooltip-text" translatable="1">Drag to select the area for the next scan.</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="width-request">360</property>
                <child>
                  <object class="GtkNotebook" id="main_notebook">
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkFrame">
                            <property name="label" translatable="1">Input Settings</property>
                            <property name="child">
                              <object class="GtkGrid" id="table1">
                                <property name="row-spacing">8</property>
                                <property name="column-spacing">10</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">10</property>
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel"><property name="label" translatable="1" comments="STR_CNMS_LS_001_02">Scan Mode:</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">0</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="combobox_scanmode"><property name="hexpand">1</property><layout><property name="column">1</property><property name="row">0</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkLabel"><property name="label" translatable="1" comments="STR_CNMS_LS_001_03">Select Source:</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">1</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="combobox_source"><property name="hexpand">1</property><layout><property name="column">1</property><property name="row">1</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkLabel"><property name="label" translatable="1" comments="STR_CNMS_LS_001_05">Paper Size:</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">2</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="combobox_size"><property name="hexpand">1</property><layout><property name="column">1</property><property name="row">2</property></layout></object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkFrame">
                            <property name="label" translatable="1">Output Settings</property>
                            <property name="child">
                              <object class="GtkGrid">
                                <property name="row-spacing">8</property>
                                <property name="column-spacing">10</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">10</property>
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <child>
                                  <object class="GtkLabel"><property name="label" translatable="1" comments="STR_CNMS_LS_001_04">Color Mode:</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">0</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="combobox_colormode"><property name="hexpand">1</property><layout><property name="column">1</property><property name="row">0</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkLabel"><property name="label" translatable="1" comments="STR_CNMS_LS_999_99">Resolution:</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">1</property></layout></object>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="combobox_resolution"><property name="hexpand">1</property><layout><property name="column">1</property><property name="row">1</property></layout></object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="tab">
                      <object class="GtkLabel"><property name="label" translatable="1">Basic Mode</property></object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                              <object class="GtkFrame">
                                <property name="label" translatable="1">Histogram</property>
                                <property name="child">
                                  <object class="GtkDrawingArea" id="histogram_area">
                                    <property name="height-request">110</property>
                                    <property name="hexpand">1</property>
                                    <property name="margin-top">8</property>
                                    <property name="margin-bottom">8</property>
                                    <property name="margin-start">8</property>
                                    <property name="margin-end">8</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="row-spacing">7</property>
                                <property name="column-spacing">8</property>
                                <child><object class="GtkLabel"><property name="label" translatable="1">Brightness</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">0</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_brightness"><property name="hexpand">1</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">-100</property><property name="upper">100</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">0</property></layout></object></child>
                                <child><object class="GtkLabel"><property name="label" translatable="1">Contrast</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">1</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_contrast"><property name="hexpand">1</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">-100</property><property name="upper">100</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">1</property></layout></object></child>
                                <child><object class="GtkLabel"><property name="label" translatable="1">Gamma</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">2</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_gamma"><property name="hexpand">1</property><property name="digits">1</property><property name="value-pos">right</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0.1</property><property name="upper">5</property><property name="value">1</property><property name="step-increment">0.1</property><property name="page-increment">0.5</property></object></property><layout><property name="column">1</property><property name="row">2</property></layout></object></child>
                                <child><object class="GtkLabel"><property name="label" translatable="1">Black point</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">3</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_black_point"><property name="hexpand">1</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">254</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">3</property></layout></object></child>
                                <child><object class="GtkLabel"><property name="label" translatable="1">White point</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">4</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_white_point"><property name="hexpand">1</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">1</property><property name="upper">255</property><property name="value">255</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">4</property></layout></object></child>
                                <child><object class="GtkLabel"><property name="label" translatable="1">Tone curve</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">5</property></layout></object></child>
                                <child><object class="GtkComboBoxText" id="combobox_curve"><property name="active">0</property><items><item translatable="1">Linear</item><item translatable="1">S curve</item><item translatable="1">High key</item><item translatable="1">Low key</item><item translatable="1">Invert</item></items><layout><property name="column">1</property><property name="row">5</property></layout></object></child>
                                <child><object class="GtkCheckButton" id="check_threshold"><property name="label" translatable="1">Threshold</property><layout><property name="column">0</property><property name="row">6</property></layout></object></child>
                                <child><object class="GtkScale" id="scale_threshold"><property name="hexpand">1</property><property name="sensitive">0</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">255</property><property name="value">128</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">6</property></layout></object></child>
                              </object>
                            </child>
                            <child><object class="GtkCheckButton" id="check_unsharp"><property name="label" translatable="1">Unsharp mask</property></object></child>
                            <child><object class="GtkCheckButton" id="check_descreen"><property name="label" translatable="1">Descreen</property></object></child>
                            <child>
                              <object class="GtkFrame">
                                <property name="label" translatable="1">Software corrections</property>
                                <property name="child">
                                  <object class="GtkGrid">
                                    <property name="row-spacing">7</property>
                                    <property name="column-spacing">8</property>
                                    <property name="margin-top">8</property>
                                    <property name="margin-bottom">8</property>
                                    <property name="margin-start">8</property>
                                    <property name="margin-end">8</property>
                                    <child><object class="GtkCheckButton" id="check_auto_tone"><property name="label" translatable="1">Auto tone</property><layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout></object></child>
                                    <child><object class="GtkCheckButton" id="check_color_balance"><property name="label" translatable="1">Automatic color balance</property><layout><property name="column">0</property><property name="row">1</property><property name="column-span">2</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Saturation</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">2</property></layout></object></child>
                                    <child><object class="GtkScale" id="scale_saturation"><property name="hexpand">1</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">-100</property><property name="upper">100</property><property name="step-increment">1</property><property name="page-increment">10</property></object></property><layout><property name="column">1</property><property name="row">2</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Dust and scratches</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">3</property></layout></object></child>
                                    <child><object class="GtkComboBoxText" id="combobox_dust"><property name="active">0</property><items><item translatable="1">Off</item><item translatable="1">Low</item><item translatable="1">Medium</item><item translatable="1">High</item></items><layout><property name="column">1</property><property name="row">3</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Fading correction</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">4</property></layout></object></child>
                                    <child><object class="GtkComboBoxText" id="combobox_fading"><property name="active">0</property><items><item translatable="1">Off</item><item translatable="1">Low</item><item translatable="1">Medium</item><item translatable="1">High</item></items><layout><property name="column">1</property><property name="row">4</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Grain reduction</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">5</property></layout></object></child>
                                    <child><object class="GtkComboBoxText" id="combobox_grain"><property name="active">0</property><items><item translatable="1">Off</item><item translatable="1">Low</item><item translatable="1">Medium</item><item translatable="1">High</item></items><layout><property name="column">1</property><property name="row">5</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Backlight correction</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">6</property></layout></object></child>
                                    <child><object class="GtkComboBoxText" id="combobox_backlight"><property name="active">0</property><items><item translatable="1">Off</item><item translatable="1">Low</item><item translatable="1">Medium</item><item translatable="1">High</item></items><layout><property name="column">1</property><property name="row">6</property></layout></object></child>
                                    <child><object class="GtkLabel"><property name="label" translatable="1">Output scale (%)</property><property name="halign">start</property><layout><property name="column">0</property><property name="row">7</property></layout></object></child>
                                    <child><object class="GtkScale" id="scale_output"><property name="hexpand">1</property><property name="digits">0</property><property name="value-pos">right</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">25</property><property name="upper">400</property><property name="value">100</property><property name="step-increment">5</property><property name="page-increment">25</property></object></property><layout><property name="column">1</property><property name="row">7</property></layout></object></child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <property name="homogeneous">1</property>
                                <child><object class="GtkButton" id="button_reset_crop"><property name="label" translatable="1">Reset crop</property></object></child>
                                <child><object class="GtkButton" id="button_reset_adjustments"><property name="label" translatable="1">Defaults</property></object></child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child type="tab">
                      <object class="GtkLabel"><property name="label" translatable="1">Advanced Mode</property></object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="homogeneous">1</property>
                    <child><object class="GtkButton" id="button_scanjpeg"><property name="label" translatable="1" comments="STR_CNMS_LS_001_06">Scan (JPEG)</property></object></child>
                    <child><object class="GtkButton" id="button_scanpdf"><property name="label" translatable="1" comments="STR_CNMS_LS_001_07">Scan (PDF)</property></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator"/>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <child><object class="GtkLabel"><property name="hexpand">1</property></object></child>
                    <child><object class="GtkButton" id="button_close"><property name="label" translatable="1" comments="STR_CNMS_LS_001_08">Close</property><property name="width-request">110</property></object></child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
